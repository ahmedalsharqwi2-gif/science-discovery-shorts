  "captions": [
    {
      "text": "الوش الحجري اللي قدامك مش قطعة",
      "startMs": 0,
      "endMs": 2060,
      "timestampMs": null,
      "confidence": null
    },
    {
      "text": "ديكور بتترفع. دي صورة من إنقاذ",
      "startMs": 2620,
      "endMs": 4740,
      "timestampMs": null,
      "confidence": null
    },
    {
      "text": "أبو سمبل، لما معبد منحوت في",
      "startMs": 4740,
      "endMs": 6720,
      "timestampMs": null,
      "confidence": null
    },
    {
      "text": "الصخر كان لازم يتفك ويتنقل. السؤال",
      "startMs": 6720,
      "endMs": 10040,
      "timestampMs": null,
      "confidence": null
    },
    {
      "text": "المرعب وقتها: إزاي تنقذ أثر ضخم،",
      "startMs": 10040,
      "endMs": 13340,
      "timestampMs": null,
      "confidence": null
    },
    {
      "text": "من غير ما تضيع ملامحه؟ مع",
      "startMs": 13340,
      "endMs": 15520,
      "timestampMs": null,
      "confidence": null
    },
    {
      "text": "بناء السد العالي، خزان المياه الجديد",
      "startMs": 15520,
      "endMs": 18040,
      "timestampMs": null,
      "confidence": null
    },
    {
      "text": "كان هيغطي مواقع أثرية في النوبة.",
      "startMs": 18040,
      "endMs": 20340,
      "timestampMs": null,
      "confidence": null
    },
    {
      "text": "مصر والسودان طلبوا مساعدة اليونسكو، لأن",
      "startMs": 20340,
      "endMs": 22920,
      "timestampMs": null,
      "confidence": null
    },
    {
      "text": "التحدي ماكانش نقل تمثال صغير. كان",
      "startMs": 22920,
      "endMs": 25300,
      "timestampMs": null,
      "confidence": null
    },
    {
      "text": "إنقاذ معابد كاملة، قبل ما المياه",
      "startMs": 25300,
      "endMs": 27600,
      "timestampMs": null,
      "confidence": null
    },
    {
      "text": "توصل لمكانها.",
      "startMs": 27600,
      "endMs": 28540,
      "timestampMs": null,
      "confidence": null
    }
