{
  "duration": 55.76,
  "scenes": [
    {
      "id": "scene_1",
      "label": "الشمس والقمر",
      "narration": "الشمس هي الجسم الوحيد في المجموعة الشمسية الذي يضيء بذاته بينما يعكس القمر ضوءها.",
      "labels": [
        "شمس",
        "ضوء"
      ],
      "start": 0,
      "end": 7.52
    },
    {
      "id": "scene_2",
      "label": "دوران الفضاء",
      "narration": "من الفضاء نرى الأرض والقمر يتحركان معا في مدارهما المستمر حول الشمس بكل دقة.",
      "labels": [
        "الفضاء",
        "مدار"
      ],
      "start": 7.52,
      "end": 15.08
    },
    {
      "id": "scene_3",
      "label": "إضاءة الجانبين",
      "narration": "يحتوي القمر على جانب نهاري وجانب ليلي يتغيران باستمرار أثناء دوران القمر حول نفسه.",
      "labels": [
        "جانب نهاري",
        "جانب ليلي"
      ],
      "start": 15.08,
      "end": 21.78
    },
    {
      "id": "scene_4",
      "label": "مراحل النور",
      "narration": "يتغير شكل القمر في السماء تدريجيا بين الهلال والبدر بسبب زاوية الرؤية وحركة مداره.",
      "labels": [
        "هلال",
        "بدر"
      ],
      "start": 21.78,
      "end": 27.98
    },
    {
      "id": "scene_5",
      "label": "دورة الشهر",
      "narration": "تتكرر دورة أطوار القمر الكاملة خلال مدة تقارب خمسة وعشرين يوما من كل شهر.",
      "labels": [
        "دورة",
        "شهر"
      ],
      "start": 27.98,
      "end": 34.66
    },
    {
      "id": "scene_6",
      "label": "القفل المددي",
      "narration": "يرتبط القمر بالأرض بقفل مددي يجعلنا نرى وجها واحدا منه طوال رحلته الفضائية.",
      "labels": [
        "قفل مددي",
        "وجه واحد"
      ],
      "start": 34.66,
      "end": 41.2
    },
    {
      "id": "scene_7",
      "label": "التذبذب والظلال",
      "narration": "تؤدي حركة المدار غير الدائرية إلى ظهور ميل طفيف يتيح لنا رؤية أجزاء إضافية أحيانا.",
      "labels": [
        "تذبذب",
        "مدار"
      ],
      "start": 41.2,
      "end": 48.42
    },
    {
      "id": "scene_8",
      "label": "الخلاصة الكونية",
      "narration": "توضح هذه الظواهر كيف تتفاعل حركة الكواكب والنجوم لترسم أطوار القمر المتنوعة بوضوح تام.",
      "labels": [
        "ظواهر",
        "كواكب"
      ],
      "start": 48.42,
      "end": 55.76
    }
  ],
