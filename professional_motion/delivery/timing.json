  "caption_groups": [
    {
      "text": "المشتري هو الكوكب الخامس من الشمس،",
      "start": 0,
      "end": 2.86
    },
    {
      "text": "وهو الأكبر حجماً في المجموعة الشمسية",
      "start": 2.86,
      "end": 5.46
    },
    {
      "text": "كلها، بكتلة أضخم من باقي الكواكب",
      "start": 5.46,
      "end": 8.52
    },
    {
      "text": "مجتمعة بأضعاف كثيرة. الكوكب ده بيمتلك",
      "start": 8.52,
      "end": 12.02
    },
    {
      "text": "خصائص ضخمة بتخليه فريد من نوعه",
      "start": 12.02,
      "end": 14.54
    },
    {
      "text": "مقارنة بباقي كواكب المجموعة الشمسية. لو",
      "start": 14.54,
      "end": 17.78
    },
    {
      "text": "اعتبرنا المشتري قوقعة فارغة، فهوا ممكن",
      "start": 17.78,
      "end": 20.48
    },
    {
      "text": "يستوعب ألف كوكب بحجم الأرض جوه",
      "start": 20.48,
      "end": 23.04
    },
    {
      "text": "منه. الحجم الهائل ده بيحيط بيه",
      "start": 23.1,
      "end": 26.48
    },
    {
      "text": "نظام معقد من الأقمار والحلقات وآلاف",
      "start": 26.58,
      "end": 29.66
    },
    {
      "text": "الأجسام الصغيرة اللي بتدور في مداره",
      "start": 29.64,
      "end": 31.14
    },
    {
      "text": "الفلكي بشكل دائم ومستمر. بيتبع الكوكب",
      "start": 31.14,
      "end": 34.46
    },
    {
      "text": "العملاق أكتر من مية قمر جرى",
      "start": 34.44,
      "end": 36.88
    },
    {
      "text": "التعرف عليها رسمياً. الصور المركبة بتوضح",
      "start": 37.2,
      "end": 40.02
    },
    {
      "text": "حافة الكوكب ومعاها أقماره الأربعة الكبرى",
      "start": 40.02,
      "end": 43.06
    },
    {
      "text": "اللي بتضم آيو ووروبا وجانيميد وكاليستو،",
      "start": 43.06,
      "end": 45.28
    },
    {
      "text": "ودي بتشكل جزء أساسي من النظام",
      "start": 46.16,
      "end": 48.58
    },
    {
      "text": "الجوفي المحيط بالمشتري. الملك بين الكواكب",
      "start": 48.82,
      "end": 52.2
    },
    {
      "text": "مش بطيء أبداً، بالعكس ده بيمتلك",
      "start": 52.2,
      "end": 54.44
    },
    {
      "text": "أسرع يوم في المجموعة الشمسية كلها.",
      "start": 54.44,
      "end": 57.08
    },
    {
      "text": "الدوران الكامل حوالين محوره بيستغرق حوالي",
      "start": 57.08,
      "end": 60.06
    },
    {
      "text": "تسع ساعات وتسع من عشرة من",
      "start": 60.22,
      "end": 61.7
    },
    {
      "text": "الساعة بس، وده سرعة دوران هائلة",
      "start": 61.7,
      "end": 63.52
    },
    {
      "text": "بالنسبة لحجمه الضخم. المجال ده اتدرس",
      "start": 63.94,
      "end": 66.96
    },
    {
      "text": "عبر رحلات فضائية كتير ومركبات عدت",
      "start": 67.18,
      "end": 69.56
    },
    {
      "text": "من جنبه وهي في طريقها لعوالم",
      "start": 69.56,
      "end": 71.16
    },
    {
      "text": "tانية بعيدة. مركبة جونو تابعة لوكالة",
      "start": 71.3,
      "end": 74.16
    },
    {
      "text": "ناسا بتدرس الكوكب ده حالياً مباشرة",
      "start": 74.16,
      "end": 76.92
    },
    {
      "text": "من مداره لتسجيل تفاصيل حركة الغلاف",
      "start": 76.92,
      "end": 79.26
    },
    {
      "text": "الجوي والعواصف. في تاريخ الثاني عشر",
      "start": 79.38,
      "end": 82.5
    },
    {
      "text": "من فبراير عام ألفين وتسعة عشر،",
      "start": 82.66,
      "end": 83.58
    },
    {
      "text": "قدرت مركبة جونو تصور البقعة الحمراء",
      "start": 85.32,
      "end": 87.54
    },
    {
      "text": "الكبرى بوضوح كبير. الصورة دي جرى",
      "start": 87.54,
      "end": 90.48
    },
    {
      "text": "تحسينها بناء على بيانات ومعلومات مقدمة",
      "start": 90.84,
      "end": 93.04
    },
    {
      "text": "من المؤسسات العلمية المختصة بدراسة الفضاء.",
      "start": 93.04,
      "end": 95.78
    },
    {
      "text": "التفاصيل الأولى والدقيقة عن المشتري اترصدت",
      "start": 95.78,
      "end": 98.68
    },
    {
      "text": "لأول مرة سنة ألف وستمائة وعشرة",
      "start": 99.32,
      "end": 100.68
    },
    {
      "text": "عن طريق العالم جاليليو جاليلي باستخدام",
      "start": 101.38,
      "end": 104.52
    },
    {
      "text": "تلسكوب صغير صنعه بنفسه، ومن الوقت",
      "start": 104.52,
      "end": 107.3
    },
    {
      "text": "ده وبدأت البشرية تفهم أسرار الكوكب",
      "start": 107.3,
      "end": 109.58
    },
    {
      "text": "التدريجية. الرحلات مستمرة لحد النهاردة، زي",
      "start": 110.5,
      "end": 113.0
    },
    {
      "text": "إطلاق مركبة يوروبا كليبر في الرابع",
      "start": 113.0,
      "end": 115.24
    },
    {
      "text": "عشر من أكتوبر عام ألفين وأربعة",
      "start": 115.32,
      "end": 116.66
    },
    {
      "text": "وعشرين من فلوريدا، عشان تتوجه لدراسة",
      "start": 116.7,
      "end": 119.54
    },
    {
      "text": "قمر أوروبا الجليدي التابع للمشتري وتفحص",
      "start": 119.54,
      "end": 122.34
    },
    {
      "text": "طبيعته عن قرب.",
      "start": 122.34,
      "end": 122.86
    }
  ],
