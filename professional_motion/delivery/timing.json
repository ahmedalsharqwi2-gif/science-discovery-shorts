  "scenes": [
    {
      "id": "scene_1",
      "label": "الكوكب العملاق",
      "narration": "المشتري هو الكوكب الخامس من الشمس، وهو الأكبر حجماً في المجموعة الشمسية كلها، بكتلة أضخم من باقي الكواكب مجتمعة بأضعاف كثيرة. الكوكب ده بيمتلك خصائص ضخمة بتخليه فريد من نوعه مقارنة بباقي كواكب المجموعة الشمسية.",
      "labels": [
        "الكوكب الخامس",
        "المجموعة الشمسية"
      ],
      "visual_mode": "hero",
      "evidence_excerpt_id": 1,
      "evidence_quote": "in the solar system, by far — more than twice as massive as the other",
      "start": 0,
      "end": 17.5
    },
    {
      "id": "scene_2",
      "label": "الحجم والمدار",
      "narration": "لو اعتبرنا المشتري قوقعة فارغة، فهوا ممكن يستوعب ألف كوكب بحجم الأرض جوه منه. الحجم الهائل ده بيحيط بيه نظام معقد من الأقمار والحلقات وآلاف الأجسام الصغيرة اللي بتدور في مداره الفلكي بشكل دائم ومستمر.",
      "labels": [
        "ألف كوكب",
        "نظام معقد"
      ],
      "visual_mode": "orbit",
      "evidence_excerpt_id": 3,
      "evidence_quote": "planet in our solar system. If Jupiter was a hollow shell, 1,000 Earths could fit",
      "start": 17.5,
      "end": 32.96
    },
    {
      "id": "scene_3",
      "label": "أكبر الأقمار",
      "narration": "بيتبع الكوكب العملاق أكتر من مية قمر جرى التعرف عليها رسمياً. الصور المركبة بتوضح حافة الكوكب ومعاها أقماره الأربعة الكبرى اللي بتضم آيو ووروبا وجانيميد وكاليستو، ودي بتشكل جزء أساسي من النظام الجوفي المحيط بالمشتري.",
      "labels": [
        "النظام الجوفي"
      ],
      "visual_mode": "light",
      "evidence_excerpt_id": 17,
      "evidence_quote": "composite image shows the edge of Jupiter, and Jupiter's four largest moons. From top to",
      "start": 32.96,
      "end": 51.28
    },
    {
      "id": "scene_4",
      "label": "دوران سريع",
      "narration": "الملك بين الكواكب مش بطيء أبداً، بالعكس ده بيمتلك أسرع يوم في المجموعة الشمسية كلها. الدوران الكامل حوالين محوره بيستغرق حوالي تسع ساعات وتسع من عشرة من الساعة بس، وده سرعة دوران هائلة بالنسبة لحجمه الضخم.",
      "labels": [
        "أسرع يوم",
        "حوالين محوره"
      ],
      "visual_mode": "light",
      "evidence_excerpt_id": 5,
      "evidence_quote": "day in the solar system, taking about 9.9 hours to spin around once on its",
      "start": 51.28,
      "end": 66.32
    },
    {
      "id": "scene_5",
      "label": "حركة الفضاء",
      "narration": "المجال ده اتدرس عبر رحلات فضائية كتير ومركبات عدت من جنبه وهي في طريقها لعوالم tانية بعيدة. مركبة جونو تابعة لوكالة ناسا بتدرس الكوكب ده حالياً مباشرة من مداره لتسجيل تفاصيل حركة الغلاف الجوي والعواصف.",
      "labels": [
        "مركبة جونو",
        "من مداره"
      ],
      "visual_mode": "orbit",
      "evidence_excerpt_id": 10,
      "evidence_quote": "and spacecraft passing by on their way to other worlds. NASA’s Juno spacecraft currently is",
      "start": 66.32,
      "end": 80.62
    },
    {
      "id": "scene_6",
      "label": "البقعة الحمراء",
      "narration": "في تاريخ الثاني عشر من فبراير عام ألفين وتسعة عشر، قدرت مركبة جونو تصور البقعة الحمراء الكبرى بوضوح كبير. الصورة دي جرى تحسينها بناء على بيانات ومعلومات مقدمة من المؤسسات العلمية المختصة بدراسة الفضاء.",
      "labels": [
        "البقعة الحمراء",
        "عام ألفين وتسعة عشر"
      ],
      "visual_mode": "detail",
      "evidence_excerpt_id": 6,
      "evidence_quote": "axis. Get the Facts NASA’s Juno spacecraft imaged Jupiter’s Great Red Spot on Feb. 12,",
      "start": 80.62,
      "end": 95.78
    },
    {
      "id": "scene_7",
      "label": "رصد جاليليو",
      "narration": "التفاصيل الأولى والدقيقة عن المشتري اترصدت لأول مرة سنة ألف وستمائة وعشرة عن طريق العالم جاليليو جاليلي باستخدام تلسكوب صغير صنعه بنفسه، ومن الوقت ده وبدأت البشرية تفهم أسرار الكوكب التدريجية.",
      "labels": [
        "جاليليو جاليلي",
        "تلسكوب صغير"
      ],
      "visual_mode": "detail",
      "evidence_excerpt_id": 8,
      "evidence_quote": "Exploring Jupiter The first detailed observations of Jupiter were made by Galileo Galilei in 1610",
      "start": 95.78,
      "end": 110.5
    },
    {
      "id": "scene_8",
      "label": "استكشاف أبعد",
      "narration": "الرحلات مستمرة لحد النهاردة، زي إطلاق مركبة يوروبا كليبر في الرابع عشر من أكتوبر عام ألفين وأربعة وعشرين من فلوريدا، عشان تتوجه لدراسة قمر أوروبا الجليدي التابع للمشتري وتفحص طبيعته عن قرب.",
      "labels": [
        "يوروبا كليبر",
