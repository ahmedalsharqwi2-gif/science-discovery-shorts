      "labels": [
        "كوكب الأرض"
      ],
      "visual_mode": "hero",
      "evidence_excerpt_id": 3,
      "evidence_quote": "Earth on a dark and stormy night, of course. The ghostly scene was photographed at",
      "start": 0,
      "end": 16.1
    },
    {
