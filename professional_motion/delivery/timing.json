  "caption_groups": [
    {
      "text": "حلقات زحل اللي بنشوفها في الصور",
      "start": 0,
      "end": 1.86
    },
    {
      "text": "مش قرص واحد صلب زي ما",
      "start": 1.86,
      "end": 3.64
    },
    {
      "text": "ناس كتير فاكرة. دي في الحقيقة",
      "start": 3.64,
      "end": 5.7
    },
    {
      "text": "نظام معقد بيتكون من مليارات القطع",
      "start": 5.7,
      "end": 7.86
    },
    {
      "text": "الصغيرة من الثلج والصخور اللي عليها",
      "start": 7.86,
      "end": 10.4
    },
    {
      "text": "طبقة من الغبار، وكل قطعة بتتحرك",
      "start": 10.4,
      "end": 13.02
    },
    {
      "text": "لوحدها وبسرعة مختلفة حوالين الكوكب. العلماء",
      "start": 13.02,
      "end": 17.02
    },
    {
      "text": "بيعتقدوا إن الحلقات دي عبارة عن",
      "start": 17.02,
      "end": 18.94
    },
    {
      "text": "بقايا مذنبات أو كويكبات أو حتى",
      "start": 18.94,
      "end": 21.42
    },
    {
      "text": "أقمار قديمة اتعرضت لقوة جاذبية زحل",
      "start": 21.42,
      "end": 24.42
    },
    {
      "text": "الهائلة واتفتت قبل ما تقدر تقرب",
      "start": 25.9,
      "end": 27.04
    },
    {
      "text": "أكتر من كده للكوكب، فتحولت للكتل",
      "start": 27.04,
      "end": 29.96
    },
    {
      "text": "اللي قدامنا دي. حجم الأجزاء اللي",
      "start": 29.96,
      "end": 32.22
    },
    {
      "text": "بتلف دي بيتنوع بشكل غريب جدا.",
      "start": 32.22,
      "end": 34.38
    },
    {
      "text": "فيه حبيبات ثلجية صغيرة قد التراب،",
      "start": 34.38,
      "end": 37.08
    },
    {
      "text": "وفيه قطع تانية بحجم البيت، وكمان",
      "start": 37.08,
      "end": 39.9
    },
    {
      "text": "فيه أجزاء ضخمة بتوصل لأحجام الجبال",
      "start": 39.9,
      "end": 42.24
    },
    {
      "text": "العالية وهيايمة في الفضاء حوالين الكوكب.",
      "start": 42.24,
      "end": 45.32
    },
    {
      "text": "نظام الحلقات ده بيمتد لمسافة بتصل",
      "start": 45.92,
      "end": 48.52
    },
    {
      "text": "لحد مائة خمسة وسبعين ألف ميل",
      "start": 48.52,
      "end": 50.46
    },
    {
      "text": "بعيد عن زحل. بس المدهش إن",
      "start": 50.46,
      "end": 52.52
    },
    {
      "text": "السمك الرأسي للحلقات الأساسية رفيع جدا،",
      "start": 52.52,
      "end": 55.24
    },
    {
      "text": "وبيتراوح غالبا حول تلاتين قدم بس.",
      "start": 55.24,
      "end": 58.94
    },
    {
      "text": "الحلقات دي متسمية بالحروف الأبجدية حسب",
      "start": 58.94,
      "end": 61.48
    },
    {
      "text": "ترتيب اكتشافها. الحلقات الأساسية هي إيه",
      "start": 61.48,
      "end": 63.98
    },
    {
      "text": "وبي وسي، وفيه حلقات تانية أضعف",
      "start": 65.26,
      "end": 67.18
    },
    {
      "text": "زي دي وإي وأف وجي، وكل",
      "start": 67.18,
      "end": 70.58
    },
    {
      "text": "مجموعة قريبة من بعضها بمسافات محسوبة.",
      "start": 70.58,
      "end": 72.68
    },
    {
      "text": "لو بصينا جوه الترتيب ده، هنلاقي",
      "start": 72.7,
      "end": 75.04
    },
    {
      "text": "فراغ كبير وفاصل واضح بيقسم الحلقات.",
      "start": 75.42,
      "end": 77.78
    },
    {
      "text": "الفجوة دي اسمها فجوة كاسيني، وعرضها",
      "start": 78.16,
      "end": 81.34
    },
    {
      "text": "بيبلغ حوالي ألفين وتسع ميكون ميل،",
      "start": 81.34,
      "end": 83.82
    },
    {
      "text": "وهي اللي بتفصل بين الحلقات إيه",
      "start": 83.82,
      "end": 85.88
    },
    {
      "text": "وبي بوضوح. معلوماتنا عن التفاصيل الدقيقة",
      "start": 86.34,
      "end": 89.32
    },
    {
      "text": "دي اتثبتت واتوثقت بفضل مركبة كاسيني",
      "start": 89.32,
      "end": 91.96
    },
    {
      "text": "الفضائية التابعة لوكالة ناسا. المركبة دي",
      "start": 91.96,
      "end": 94.9
    },
    {
      "text": "وصلت لزحل سنة ألفين وأربعة، وفضلت",
      "start": 94.9,
      "end": 97.88
    },
    {
      "text": "تصور وتدرس النظام ده لحد ما",
      "start": 97.88,
      "end": 99.86
    },
    {
      "text": "الرحلة انتهت في منتصف سبتمبر سنة",
      "start": 99.86,
      "end": 102.92
    },
    {
      "text": "ألفين وسبعتاشر. حتى بعد كل الصور",
      "start": 103.44,
      "end": 105.76
    },
    {
      "text": "والبيانات اللي جمعتها المركبات الفضائية، حلقات",
      "start": 105.76,
      "end": 108.7
    },
    {
      "text": "زحل لسه بتخبي تفاصيل كتيرة عن",
      "start": 108.7,
      "end": 111.1
    },
    {
      "text": "تكوين النظام الشمسي القديم. وكل دراسة",
      "start": 111.1,
      "end": 114.06
    },
    {
      "text": "جديدة بتأكد إننا لسه في أول",
      "start": 114.06,
      "end": 116.16
    },
    {
      "text": "الطريق عشان نفهم أسرار الكوكب العظيم",
      "start": 116.16,
      "end": 118.66
    },
    {
      "text": "ده.",
      "start": 118.66,
      "end": 118.84
    }
  ],
