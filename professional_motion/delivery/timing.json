  "caption_groups": [
    {
      "text": "إيه هو الكوكب المخيف ده؟ هو",
      "start": 0,
      "end": 2.78
    },
    {
      "text": "كوكب الأرض في ليلة ظلام وعاصفة،",
      "start": 2.78,
      "end": 4.5
    },
    {
      "text": "والصورة اتصورت في هفيرير بايسلندا عشان",
      "start": 5.48,
      "end": 8.12
    },
    {
      "text": "تعرض مشهد مش معتاد بيجمع بين",
      "start": 8.12,
      "end": 10.34
    },
    {
      "text": "الظواهر الطبيعية وعتمة الليل بشكل مرعب",
      "start": 10.34,
      "end": 13.76
    },
    {
      "text": "ومثير للاهتمام في نفس الوقت. المكان",
      "start": 13.76,
      "end": 16.52
    },
    {
      "text": "عبارة عن منطقة نشطة حرارياً وأرضيتها",
      "start": 16.52,
      "end": 19.14
    },
    {
      "text": "بركانية في شمال شرق أيسلندا، وبتظهر",
      "start": 19.22,
      "end": 21.82
    },
    {
      "text": "فيها مظاهر طبيعية مرعبة مع التضاريس",
      "start": 21.82,
      "end": 23.8
    },
    {
      "text": "الوعرة اللي بتخلي اللقطة كأنها جاية",
      "start": 24.32,
      "end": 26.6
    },
    {
      "text": "من عالم تاني خالص بعيد عن",
      "start": 26.58,
      "end": 28.48
    },
    {
      "text": "كوكبنا المعتاد. النشاط الشمسي هو اللي",
      "start": 28.48,
      "end": 31.16
    },
    {
      "text": "بيحفز عواصف مغناطيسية أرضية قوية تطلق",
      "start": 31.16,
      "end": 34.5
    },
    {
      "text": "جسيمات طاقة هائلة كانت محبوسة جوه",
      "start": 34.5,
      "end": 36.68
    },
    {
      "text": "المجال المغناطيسي لكوكبنا، وده بيمهد الطريق",
      "start": 36.74,
      "end": 39.72
    },
    {
      "text": "لظهور تأثيرات بصرية مذهلة في طبقات",
      "start": 39.72,
      "end": 42.52
    },
    {
      "text": "الجو العليا. الجسيمات لما بتخترق الغلاف",
      "start": 42.52,
      "end": 44.98
    },
    {
      "text": "الجوي العلوي عند خطوط العرض العالية،",
      "start": 45.62,
      "end": 47.56
    },
    {
      "text": "بتعمل عروض الشفق القطبى في السما",
      "start": 47.56,
      "end": 49.82
    },
    {
      "text": "المليانة نجوم، وبتلون الليل بألوان خضراء",
      "start": 50.02,
      "end": 53.1
    },
    {
      "text": "ساحرة بتغطي الأفق كله بطريقة فريدة",
      "start": 53.1,
      "end": 56.12
    },
    {
      "text": "ومخيفة. أبخرة وغازات على شكل أبراج",
      "start": 56.1,
      "end": 59.4
    },
    {
      "text": "شبحية بتطلع من الفتحات المحلية عشان",
      "start": 59.4,
      "end": 62.76
    },
    {
      "text": "ترقص قصاد الأضواء الخضراء الغريبة في",
      "start": 62.76,
      "end": 64.74
    },
    {
      "text": "السما، وبتخلق لوحة بصرية متكاملة تحبس",
      "start": 65.4,
      "end": 68.08
    },
    {
      "text": "أنفاس أي حد يشوفها في الظلمة.",
      "start": 68.24,
      "end": 69.82
    },
    {
      "text": "النشاط الشفقي على الأرض لسه في",
      "start": 70.38,
      "end": 72.86
    },
    {
      "text": "حالة عالية عشان الشمس في المراحل",
      "start": 72.86,
      "end": 75.38
    },
    {
      "text": "الأولى من التراجع بعد ذروة دورتها",
      "start": 75.38,
      "end": 77.98
    },
    {
      "text": "النشطة، وده معناه إن الفرصة قائمة",
      "start": 77.98,
      "end": 81.04
    },
    {
      "text": "لتكرار الظاهرة دي بشكل مستمر الفترة",
      "start": 81.04,
      "end": 83.92
    },
    {
      "text": "الجاية. قريب ممكن مظاهر شبحية تانية",
      "start": 83.92,
      "end": 87.56
    },
    {
      "text": "تظهر في منطقتك مع استمرار التقلبات",
      "start": 87.56,
      "end": 90.18
    },
    {
      "text": "دي، والصورة دي وثقها المصور ستيفان",
      "start": 90.38,
      "end": 93.58
    },
    {
      "text": "فيتر في أكتوبر سنة ألفين ستة",
      "start": 93.58,
      "end": 95.34
    },
    {
      "text": "وعشرين عشان تفضل توثيق مهم لجمال",
      "start": 96.82,
      "end": 99.24
    },
    {
      "text": "الكون وغموضه. كل يوم في صورة",
      "start": 99.24,
      "end": 102.24
    },
    {
      "text": "جديدة للكون الفسيح مع شرح مختصر",
      "start": 102.24,
      "end": 105.44
    },
    {
      "text": "كاتبه عالم فلك محترف ضمن مشروع",
      "start": 105.9,
      "end": 108.3
    },
    {
      "text": "صورة اليوم الفلكية من ناسا، عشان",
      "start": 108.3,
      "end": 110.88
    },
    {
      "text": "نقرب دايمًا من أسرار الفضاء ونفهم",
      "start": 110.88,
      "end": 113.68
    },
    {
      "text": "كوكبنا والكون من حولنا بشكل أفضل.",
      "start": 113.68,
      "end": 116.98
    }
  ],
