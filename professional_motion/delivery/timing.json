  "caption_groups": [
    {
      "text": "تخيل إن حوالين الأرض فقاعة ضخمة",
      "start": 0,
      "end": 2.78
    },
    {
      "text": "من المغناطيسية، وإحنا مش شايفينها. ناسا",
      "start": 2.78,
      "end": 5.0
    },
    {
      "text": "بتسمي المنطقة دي الغلاف المغناطيسي. الفقاعة",
      "start": 6.18,
      "end": 10.44
    },
    {
      "text": "بتحوّل مسار معظم الجسيمات اللي جاية",
      "start": 10.44,
      "end": 12.52
    },
    {
      "text": "من الشمس، ووجودها ساعد غلافنا الجوي",
      "start": 12.52,
      "end": 15.14
    },
    {
      "text": "يفضل محمي. بس الحماية دي مش",
      "start": 15.14,
      "end": 17.6
    },
    {
      "text": "معناها إن مفيش حاجة بتعدي. الشمس",
      "start": 17.6,
      "end": 20.02
    },
    {
      "text": "بتبعت باستمرار تيار من الجسيمات اسمه",
      "start": 20.42,
      "end": 22.92
    },
    {
      "text": "الرياح الشمسية. التيار ده بيقابل المجال",
      "start": 22.92,
      "end": 26.26
    },
    {
      "text": "المغناطيسي حوالين كوكبنا، فجزء كبير منه",
      "start": 26.26,
      "end": 29.18
    },
    {
      "text": "بيتحوّل بعيد. هنا لازم نفرق بين",
      "start": 29.18,
      "end": 32.0
    },
    {
      "text": "دور المجال ودور الغلاف الجوي: الغلاف",
      "start": 32.0,
      "end": 34.9
    },
    {
      "text": "الجوي نفسه بيساعد يحمينا من الأشعة",
      "start": 34.9,
      "end": 36.98
    },
    {
      "text": "فوق البنفسجية. ناسا بتقارن الأرض بالمريخ",
      "start": 36.98,
      "end": 40.56
    },
    {
      "text": "عشان توضح أهمية الدرع ده. المريخ",
      "start": 40.56,
      "end": 43.54
    },
    {
      "text": "فقد غلافه المغناطيسي من زمن بعيد،",
      "start": 43.86,
      "end": 45.74
    },
    {
      "text": "والعلماء بيرجحوا إن الرياح الشمسية ساهمت",
      "start": 45.74,
      "end": 48.12
    },
    {
      "text": "في تجريد الكوكب من معظم غلافه",
      "start": 48.7,
      "end": 50.62
    },
    {
      "text": "الجوي. ده تفسير علمي محتمل، مش",
      "start": 50.62,
      "end": 53.44
    },
    {
      "text": "تجربة بتقول إن تاريخ الكوكبين كان",
      "start": 53.44,
      "end": 55.12
    },
    {
      "text": "واحد. القصة مش بعيدة عن حياتنا",
      "start": 55.12,
      "end": 57.78
    },
    {
      "text": "اليومية. الطقس الفضائي الشديد ممكن يعطل",
      "start": 57.78,
      "end": 60.96
    },
    {
      "text": "شبكات الاتصالات، ويأثر على الملاحة بالأقمار",
      "start": 60.96,
      "end": 63.32
    },
    {
      "text": "الصناعية وشبكات الكهرباء. عشان كده دراسة",
      "start": 64.34,
      "end": 66.86
    },
    {
      "text": "المجال المغناطيسي مش مجرد رسم لخطوط",
      "start": 67.3,
      "end": 70.02
    },
    {
      "text": "حوالين كرة؛ دي محاولة نفهم خطر",
      "start": 71.24,
      "end": 72.76
    },
    {
      "text": "ممكن يوصل للتكنولوجيا اللي بنستخدمها. الغلاف",
      "start": 72.76,
      "end": 76.02
    },
    {
      "text": "المغناطيسي درع قابل للنفاذ، مش حيطة",
      "start": 76.02,
      "end": 79.5
    },
    {
      "text": "مقفولة. أحيانًا المجال اللي مع الرياح",
      "start": 79.5,
      "end": 82.12
    },
    {
      "text": "الشمسية بيتصل بمجال الأرض، وبيجبر المنطقة",
      "start": 82.12,
      "end": 86.28
    },
    {
      "text": "تعيد ترتيب نفسها. العلماء بيوصفوا فتحات",
      "start": 86.28,
      "end": 89.88
    },
    {
      "text": "بتسمح بدخول الطاقة. الفتحات دي ممكن",
      "start": 89.88,
      "end": 92.58
    },
    {
      "text": "تظهر وتقفل أكتر من مرة، وبعضها",
      "start": 92.58,
      "end": 94.34
    },
    {
      "text": "صغير وقصير وبعضها أوسع. العملية اللي",
      "start": 94.86,
      "end": 98.92
    },
    {
      "text": "بتحصل لما خطوط المجال تتقابل وتعيد",
      "start": 98.92,
      "end": 101.62
    },
    {
      "text": "ترتيب نفسها اسمها إعادة الاتصال المغناطيسي.",
      "start": 101.62,
      "end": 106.04
    },
    {
      "text": "الطاقة المخزنة ممكن تتحرر بعنف، ومعاها",
      "start": 106.04,
      "end": 108.92
    },
    {
      "text": "جسيمات مشحونة بتتحرك بسرعة كبيرة. ناسا",
      "start": 109.32,
      "end": 111.7
    },
    {
      "text": "بتدرس إزاي دخول الطاقة وتحررها مرتبطين",
      "start": 112.8,
      "end": 115.82
    },
    {
      "text": "بالعواصف المغناطيسية، وليه التغيير ده ممكن",
      "start": 115.82,
      "end": 119.1
    },
    {
      "text": "يبقى قوي بالشكل ده. عشان تشوف",
      "start": 119.1,
      "end": 121.88
    },
    {
      "text": "اللي بيحصل عن قرب، ناسا أطلقت",
      "start": 121.88,
      "end": 123.12
    },
    {
      "text": "مهمة مكوّنة من أربع مركبات فضائية",
      "start": 124.46,
      "end": 126.88
    },
    {
      "text": "بتطير في تشكيل قريب. المركبات شايلة",
      "start": 126.88,
      "end": 129.8
    },
    {
      "text": "حساسات للمجال المغناطيسي وكواشف للجسيمات، وبتقيس",
      "start": 129.8,
      "end": 133.56
    },
    {
      "text": "مناطق بتحصل فيها إعادة الاتصال. القياسات",
      "start": 133.56,
      "end": 136.78
    },
    {
      "text": "دي بتدرس حركة الإلكترونات نفسها، بدل",
      "start": 137.76,
      "end": 140.36
    },
    {
      "text": "ما نعتمد على شكل الرسمة بس.",
      "start": 140.36,
      "end": 142.82
    },
    {
      "text": "المهمة دي بتكمل بيانات بعثات تانية،",
      "start": 142.82,
      "end": 145.12
    },
    {
      "text": "عشان العلماء يفهموا فيزياء الفضاء ويحسنوا",
      "start": 145.12,
      "end": 147.94
    },
    {
      "text": "توقعات الطقس الفضائي. الفكرة مش إن",
      "start": 147.94,
      "end": 151.06
    },
    {
      "text": "الدرع كامل، ولا إننا نقدر نتنبأ",
      "start": 151.06,
      "end": 153.24
    },
    {
      "text": "بكل عاصفة بدقة. الفكرة إن كوكبنا",
      "start": 153.24,
      "end": 156.04
    },
    {
      "text": "محمي بنظام متحرك بيتفاعل مع الشمس",
      "start": 156.04,
      "end": 158.56
    },
    {
      "text": "طول الوقت، وكل قياس جديد بيكشف",
      "start": 158.56,
      "end": 161.54
    },
    {
      "text": "جزء منه.",
      "start": 161.54,
      "end": 162.14
    }
  ],
