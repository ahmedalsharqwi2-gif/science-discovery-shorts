  "caption_groups": [
    {
      "text": "تخيل كوكبنا جوه فقاعة عملاقة من",
      "start": 0,
      "end": 2.72
    },
    {
      "text": "المغناطيسية. الفقاعة دي بتحمينا كل يوم",
      "start": 3.74,
      "end": 5.52
    },
    {
      "text": "من غضب الشمس اللي بتبعت مواد",
      "start": 5.52,
      "end": 7.42
    },
    {
      "text": "شمسية بسرعة مليون ميل في الساعة",
      "start": 7.42,
      "end": 9.52
    },
    {
      "text": "أو إكتر، عشان تضمن إن الحياة",
      "start": 9.52,
      "end": 12.0
    },
    {
      "text": "تكمل على كوكبنا بأمان تام. الباحثين",
      "start": 12.24,
      "end": 13.12
    },
    {
      "text": "بصوا على كوكب المريخ اللي فقد",
      "start": 14.94,
      "end": 16.76
    },
    {
      "text": "مجاله المغناطيسي من أكتر من أربعة",
      "start": 16.76,
      "end": 19.24
    },
    {
      "text": "مليارات سنة. ده أدى لأن الرياح",
      "start": 19.24,
      "end": 21.58
    },
    {
      "text": "الشمسية جرفت معظم غلافه الجوي، وسبته",
      "start": 21.58,
      "end": 24.1
    },
    {
      "text": "عالم قاحل عكس الأرض تماماً. الدرع",
      "start": 24.78,
      "end": 28.32
    },
    {
      "text": "ده مش صلب بالكامل، دي فقاعة",
      "start": 28.32,
      "end": 30.72
    },
    {
      "text": "بتسمح بتفاعل مستمر. خطوط القوة المغناطيسية",
      "start": 30.72,
      "end": 33.52
    },
    {
      "text": "بتتقاطع وتتصل مع الرياح الشمسية القادمة،",
      "start": 35.18,
      "end": 37.36
    },
    {
      "text": "وده بيخلي المجال يعيد تشكيل نفسه",
      "start": 37.36,
      "end": 40.14
    },
    {
      "text": "وفتح ثغرات متكررة. الثغرات دي ممكن",
      "start": 40.14,
      "end": 43.06
    },
    {
      "text": "تفتح وتقفل مرات كتيرة في اليوم",
      "start": 43.06,
      "end": 44.84
    },
    {
      "text": "الواحد. لما المجال المغناطيسي للشمس يتصل",
      "start": 44.84,
      "end": 48.08
    },
    {
      "text": "بالمجال الأرضي، بتبدأ العواصف والجسيمات المشحونة",
      "start": 48.08,
      "end": 51.62
    },
    {
      "text": "تتدفق بسرعة كبيرة جداً جوه الدرع.",
      "start": 52.24,
      "end": 53.739999999999995
    },
    {
      "text": "العملية دي المعروفة بإعادة الاتصال المغناطيسي",
      "start": 53.74,
      "end": 56.82
    },
    {
      "text": "بتحرر طاقة هائلة. الارتباط ده بيخلي",
      "start": 57.78,
      "end": 61.1
    },
    {
      "text": "المجال بيمتص الطاقة الجاية من الرياح",
      "start": 61.1,
      "end": 63.2
    },
    {
      "text": "الشمسية ويطلقها بشكل متفجر في صورة",
      "start": 63.44,
      "end": 66.18
    },
    {
      "text": "عواصف جيومغناطيسية. عشان نفهم التفاصيل دي،",
      "start": 66.18,
      "end": 69.42
    },
    {
      "text": "وكالة ناسا أطلقت مهمة متعددة المقاييس",
      "start": 69.42,
      "end": 71.38
    },
    {
      "text": "في مارس ألفين وخمستاشر. المركبات الفضائية",
      "start": 72.04,
      "end": 75.36
    },
    {
      "text": "طارت بتشكيل قريب جداً لمنطقة حدوث",
      "start": 75.36,
      "end": 77.74
    },
    {
      "text": "إعادة الاتصال عشان ترصد فيزياء الإلكترونات.",
      "start": 77.74,
      "end": 80.82
    },
    {
      "text": "دراسة الكحليات دي مش للعلوم البحتة",
      "start": 81.42,
      "end": 83.52
    },
    {
      "text": "وبس، دي بتساعدنا نتوقع طقس الفضاء",
      "start": 83.52,
      "end": 86.7
    },
    {
      "text": "اللي بيأثر على شبكات الاتصالات، ونظام",
      "start": 86.7,
      "end": 89.28
    },
    {
      "text": "الجي بي إس، وشبكات الطاقة الكهربائية",
      "start": 89.28,
      "end": 90.98
    },
    {
      "text": "هنا على الأرض. البيانات اللي بتجمعها",
      "start": 91.82,
      "end": 94.42
    },
    {
      "text": "المهمة دي بتتكامل مع بعثات تانية",
      "start": 94.42,
      "end": 97.14
    },
    {
      "text": "زي كلستر وتيميس. كل ده بيدينا",
      "start": 97.14,
      "end": 100.58
    },
    {
      "text": "صورة أدق عن الغلاف المغناطيسي وبيساعدنا",
      "start": 100.58,
      "end": 103.56
    },
    {
      "text": "نفهم الفيزياء الأساسية للفضاء المحيط بينا.",
      "start": 103.56,
      "end": 106.34
    }
  ],
