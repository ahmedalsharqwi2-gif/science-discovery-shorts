  "caption_groups": [
    {
      "text": "الكسوف ده حدث سماوي بيغير شكل",
      "start": 0,
      "end": 2.86
    },
    {
      "text": "أكبر جسمين بنشوفهم في السما، وهما",
      "start": 2.86,
      "end": 5.58
    },
    {
      "text": "الشمس والقمر. الناس على الأرض بتعيش",
      "start": 5.58,
      "end": 8.9
    },
    {
      "text": "اللحظة دي لما الظاهرة بتحصل، عشان",
      "start": 8.9,
      "end": 11.3
    },
    {
      "text": "كدة هي بتلفت انتباه الكل وبتغير",
      "start": 11.3,
      "end": 13.98
    },
    {
      "text": "شكل السماء بشكل واضح ومميز قدامنا.",
      "start": 13.98,
      "end": 16.92
    },
    {
      "text": "في الفضاء الواسع، لما الأرض والقمر",
      "start": 16.92,
      "end": 19.7
    },
    {
      "text": "والشمس بينتظموا ويكونوا على خط واحد،",
      "start": 20.5,
      "end": 24.06
    },
    {
      "text": "نقدر نشوف الكسوف بوضوح. الانتظام ده",
      "start": 24.06,
      "end": 27.4
    },
    {
      "text": "هو اللي بيخلي الظاهرة تتكرر، ووكالة",
      "start": 27.4,
      "end": 29.2
    },
    {
      "text": "ناسا بتدرس الفترات دي عشان تفهم",
      "start": 30.46,
      "end": 32.14
    },
    {
      "text": "حركة الكواكب وتأثيراتها المختلفة على كوكبنا",
      "start": 32.14,
      "end": 35.04
    },
    {
      "text": "بشكل دقيق. العلاقة بين الأجرام السماوية",
      "start": 35.04,
      "end": 38.3
    },
    {
      "text": "بتحدد نوع الكسوف اللي بنشوفه. الكسوف",
      "start": 38.3,
      "end": 41.34
    },
    {
      "text": "الشمسي بيحصل بالتحديد خلال مرحلة القمر",
      "start": 41.34,
      "end": 43.82
    },
    {
      "text": "الجديد، بينما الكسوف القمري بيحصل في",
      "start": 44.18,
      "end": 47.0
    },
    {
      "text": "وقت تاني لما تكون الأرض في",
      "start": 47.0,
      "end": 48.5
    },
    {
      "text": "النص بين الشمس والقمر في مدارها",
      "start": 48.5,
      "end": 50.24
    },
    {
      "text": "الدائم. عادة مش بنقدر نشوف هالة",
      "start": 50.58,
      "end": 53.76
    },
    {
      "text": "الشمس عشان سطحها بيكون ساطع وقوي",
      "start": 53.76,
      "end": 56.42
    },
    {
      "text": "جدا بالنسبة لنا. النور الشديد ده",
      "start": 56.42,
      "end": 58.86
    },
    {
      "text": "بيخفي الغلاف الخارجي، لكن الظاهرة بتغير",
      "start": 58.86,
      "end": 61.68
    },
    {
      "text": "الوضع ده وبتسمح للباحثين برؤية أجزاء",
      "start": 61.68,
      "end": 64.24
    },
    {
      "text": "جديدة ومهمة من الشمس اللي مش",
      "start": 64.24,
      "end": 66.42
    },
    {
      "text": "بتظهر في الأوقات العادية. حركة الأجرام",
      "start": 66.42,
      "end": 69.56
    },
    {
      "text": "في مداراتها بتخلق مواسم محددة للكسوف",
      "start": 69.56,
      "end": 72.42
    },
    {
      "text": "كل سنة. المواسم دي بتتكرر بانتظام،",
      "start": 72.42,
      "end": 75.54
    },
    {
      "text": "وخلالها بتتحاذى الشمس والقمر والأرض بالشكل",
      "start": 75.54,
      "end": 78.82
    },
    {
      "text": "اللي بيسمح بوقوع الظاهرة، وده بيدل",
      "start": 79.3,
      "end": 81.7
    },
    {
      "text": "على دقة النظام الكوني اللي بيحكم",
      "start": 81.98,
      "end": 84.14
    },
    {
      "text": "حركة الكواكب والنجوم حولنا. فيه تفاصيل",
      "start": 84.14,
      "end": 87.48
    },
    {
      "text": "كتير لازم نعرفها عن أنواع الكسوف",
      "start": 87.48,
      "end": 89.66
    },
    {
      "text": "المختلفة. الكسوف الشمسي بيتقسم لأربعة أنواع",
      "start": 89.66,
      "end": 93.2
    },
    {
      "text": "رئيسية تشمل الكلي والجزئي والهجين والحلقي،",
      "start": 93.2,
      "end": 98.16
    },
    {
      "text": "والنوع اللي بنشوفه بيعتمد على مسافة",
      "start": 98.68,
      "end": 101.3
    },
    {
      "text": "القمر وطريقة اصطفافه مع الأرض والشمس",
      "start": 101.3,
      "end": 104.04
    },
    {
      "text": "بدقة. رغم جمال الظاهرة، إلا إن",
      "start": 104.04,
      "end": 107.46
    },
    {
      "text": "فيه حدود وقواعد لازم نحافظ عليها",
      "start": 107.46,
      "end": 109.56
    },
    {
      "text": "عشان سلامتنا. النظر المباشر للشمس مش",
      "start": 109.56,
      "end": 112.64
    },
    {
      "text": "مسموح بيه إلا في وقت الكلي",
      "start": 112.64,
      "end": 113.74
    },
    {
      "text": "بحذر شديد، وعشان كدة لازم نستخدم",
      "start": 115.04,
      "end": 117.32
    },
    {
      "text": "وسائل حماية مخصصة ومش النظارات العادية.",
      "start": 117.32,
      "end": 120.62
    },
    {
      "text": "في الختام، الظواهر دي مش بس",
      "start": 120.62,
      "end": 123.66
    },
    {
      "text": "منظر جميل بنشوفه في السما، دي",
      "start": 123.66,
      "end": 125.72
    },
    {
      "text": "كمان بتساعد العلماء في فهم أسرار",
      "start": 125.72,
      "end": 127.64
    },
    {
      "text": "الكون وتاريخ دوران الأرض عبر الزمن،",
      "start": 127.64,
      "end": 130.36
    },
    {
      "text": "عشان كدة ناسا لسه بتدرس الكسوف",
      "start": 130.36,
      "end": 132.84
    },
    {
